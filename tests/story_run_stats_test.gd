extends SceneTree

const StoryRunStatsClass := preload("res://scripts/story/StoryRunStats.gd")

func _init() -> void:
	var stats = StoryRunStatsClass.new()
	stats.reset("story")
	stats.record_damage("fireball", 80.0)
	stats.record_damage("fire_trail", 20.0)
	stats.record_damage("inferno_chain", 30.0, true)
	stats.record_damage("inferno_emp", 10.0, true)
	stats.record_damage("beetle", 15.0)
	stats.record_damage("objective_prop", 999.0, false, false)
	stats.record_damage("fireball", 0.0)
	stats.record_damage_taken(42.0)
	stats.record_healing(18.5)
	stats.record_enemy_defeat()
	stats.record_enemy_defeat(false)
	stats.record_revive()
	var snapshot: Dictionary = stats.snapshot()
	assert(is_equal_approx(float(snapshot.total_damage), 155.0))
	assert(is_equal_approx(float(snapshot.boss_damage), 40.0))
	assert(is_equal_approx(float(snapshot.damage_taken), 42.0))
	assert(is_equal_approx(float(snapshot.healing), 18.5))
	assert(int(snapshot.kills) == 1)
	assert(int(snapshot.revives) == 1)
	var summary: Array = snapshot.damage_summary
	assert(summary.size() == 3)
	assert(str((summary[0] as Dictionary).source_id) == "fireball")
	assert(is_equal_approx(float((summary[0] as Dictionary).damage), 100.0))
	assert(str((summary[1] as Dictionary).source_id) == "inferno_thunder")
	assert(is_equal_approx(float((summary[1] as Dictionary).damage), 40.0))
	assert(str((summary[2] as Dictionary).source_id) == "companion_beetle")
	assert(stats.top_damage(2).size() == 2)
	assert(is_equal_approx(StoryRunStatsClass.actual_applied_damage(100.0, -50.0), 100.0))
	assert(is_equal_approx(StoryRunStatsClass.actual_applied_damage(100.0, 35.0), 65.0))
	assert(is_zero_approx(StoryRunStatsClass.actual_applied_damage(100.0, 20.0, false)))
	stats.reset("boss_practice")
	assert((stats.snapshot().damage_summary as Array).is_empty())
	assert(is_zero_approx(float(stats.snapshot().total_damage)))
	print("Story Run Stats tests passed: aggregation, normalization, exclusions, totals, reset")
	quit(0)
